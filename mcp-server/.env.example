# Copia este archivo a .env (en esta misma carpeta) y complétalo.
# .env está en .gitignore: nunca se sube al repo.

# Los dos primeros son los mismos valores de tu .env.local del frontend
NEXUS_SUPABASE_URL=https://dmhlbgdakispkgbucgmq.supabase.co
NEXUS_SUPABASE_ANON_KEY=

# El correo y contraseña con los que entras a NEXUS. Se usa la anon key
# (no la service_role), así que RLS sigue aplicando y el servidor solo
# puede leer y escribir tus propias filas.
NEXUS_EMAIL=andresgilbe2021@gmail.com
NEXUS_PASSWORD=

# Límites de seguridad del worker del chat. Acotan cuánto podría consumir
# de tu cuenta de Claude alguien que entrara a NEXUS. Estos son los valores
# por defecto; solo ponelos acá si querés cambiarlos.
# NEXUS_WORKER_MAX_CHARS=2000       # largo máximo de un mensaje
# NEXUS_WORKER_MAX_PER_HOUR=20      # respuestas por hora
# NEXUS_WORKER_MAX_PER_DAY=100      # respuestas por día
# NEXUS_WORKER_MAX_AGE_HOURS=24     # descarta mensajes más viejos que esto
